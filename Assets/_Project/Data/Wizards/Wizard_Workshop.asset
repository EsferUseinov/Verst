  m_Script: {fileID: 11500000, guid: 3d8e49d323c576548a7691f17f969f4e, type: 3}
  m_Name: Wizard_Workshop
  m_EditorClassIdentifier: Assembly-CSharp::WizardDefinition
  id: workshop_basics
  displayName: "\u0406\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u0430\u0436: \u0441\u043A\u043B\u0430\u0434\u0430\u043B\u044C\u043D\u0430
    \u0434\u0456\u043B\u044C\u043D\u0438\u0446\u044F"
  intro: "2 \u0435\u043A\u0440\u0430\u043D\u0438 \u0456\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u0430\u0436\u0443
    \u0456 5 \u043F\u0438\u0442\u0430\u043D\u044C \u043F\u0440\u043E \u0446\u0435\u0445
    \u0456 \u043A\u0440\u0430\u0444\u0442 \u043C\u0430\u043D\u043E\u043C\u0435\u0442\u0440\u0430.
    \u0414\u043B\u044F \u0437\u0430\u043B\u0456\u043A\u0443 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
    80% \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0438\u0445 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0435\u0439."
  passScore: 0.8
  steps:
  - type: 0
    title: "\u0417\u043E\u043D\u0438 \u0446\u0435\u0445\u0443"
    text: "\u0421\u0442\u0435\u043B\u0430\u0436 \u0437\u0456 \u0441\u043A\u043B\u0430\u0434\u043E\u043C
      \u2013 \u043B\u0456\u0432\u043E\u0440\u0443\u0447. \u0421\u043A\u043B\u0430\u0434\u0430\u043B\u044C\u043D\u0438\u0439
      \u0441\u0442\u0456\u043B \u2013 \u043F\u043E \u0446\u0435\u043D\u0442\u0440\u0443.
      \u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u044F\u043A\u043E\u0441\u0442\u0456
      \u2013 \u043F\u0440\u0430\u0432\u043E\u0440\u0443\u0447. \u041F\u0430\u043B\u0435\u0442\u0430
      \u0434\u043B\u044F \u0432\u0456\u0434\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F
      \u2013 \u043F\u0440\u0430\u0432\u043E\u0440\u0443\u0447 \u043F\u043E\u0437\u0430\u0434\u0443."
    options: []
    correctOption: 0
    explanation: 
  - type: 0
    title: "\u041A\u0440\u0430\u0444\u0442 \u043C\u0430\u043D\u043E\u043C\u0435\u0442\u0440\u0430"
    text: "\u041F\u043E\u043A\u043B\u0430\u0434\u0438 \u0448\u0435\u0441\u0442\u0435\u0440\u043D\u044E
      \u0432 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0438\u0439 \u0441\u043B\u043E\u0442
      \u0441\u0442\u0430\u043D\u0446\u0456\u0457, \u0431\u043E\u043B\u0442 \u2013
      \u0443 \u0431\u0456\u0447\u043D\u0438\u0439. \u041A\u043E\u043B\u0438 \u043A\u043D\u043E\u043F\u043A\u0430
      \u043F\u0440\u0430\u0432\u043E\u0440\u0443\u0447 \u0441\u0442\u0430\u043D\u0435
      \u0437\u0435\u043B\u0435\u043D\u043E\u044E, \u043D\u0430\u0442\u0438\u0441\u043D\u0438
      \u0457\u0457."
    options: []
    correctOption: 0
    explanation: 
  - type: 1
    title: "\u0420\u0435\u0446\u0435\u043F\u0442"
    text: "\u0429\u043E \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0434\u043B\u044F
      \u043C\u0430\u043D\u043E\u043C\u0435\u0442\u0440\u0430?"
    options:
    - "\u0428\u0435\u0441\u0442\u0435\u0440\u043D\u044F \u0456 \u0431\u043E\u043B\u0442"
    - "\u041A\u043B\u044E\u0447 \u0456 \u0431\u043E\u043B\u0442"
    - "\u0414\u0432\u0430 \u0431\u043E\u043B\u0442\u0438"
    correctOption: 0
    explanation: "\u0420\u0435\u0446\u0435\u043F\u0442: \u0448\u0435\u0441\u0442\u0435\u0440\u043D\u044F
      + \u0431\u043E\u043B\u0442."
  - type: 1
    title: "\u0421\u043B\u043E\u0442\u0438 \u0441\u0442\u0430\u043D\u0446\u0456\u0457"
    text: "\u041A\u0443\u0434\u0438 \u043A\u043B\u0430\u0434\u0435\u0442\u044C\u0441\u044F
      \u0448\u0435\u0441\u0442\u0435\u0440\u043D\u044F?"
    options:
    - "\u0423 \u0431\u0456\u0447\u043D\u0438\u0439 \u0441\u043B\u043E\u0442"
    - "\u0423 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0438\u0439
      \u0441\u043B\u043E\u0442"
    - "\u0423 \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0439 \u0441\u043B\u043E\u0442"
    correctOption: 1
    explanation: "\u0426\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0438\u0439
      \u0441\u043B\u043E\u0442 \u043F\u0440\u0438\u0439\u043C\u0430\u0454 \u0434\u0435\u0442\u0430\u043B\u0456,
      \u0431\u0456\u0447\u043D\u0456 \u2013 \u043A\u0440\u0456\u043F\u043B\u0435\u043D\u043D\u044F."
  - type: 1
    title: "\u041A\u043D\u043E\u043F\u043A\u0430 \u043A\u0440\u0430\u0444\u0442\u0443"
    text: "\u0429\u043E \u043E\u0437\u043D\u0430\u0447\u0430\u0454 \u0437\u0435\u043B\u0435\u043D\u0430
      \u043A\u043D\u043E\u043F\u043A\u0430?"
    options:
    - "\u0421\u0442\u0430\u043D\u0446\u0456\u044F \u043D\u0435\u0441\u043F\u0440\u0430\u0432\u043D\u0430"
    - "\u041A\u0440\u0430\u0444\u0442 \u0443\u0436\u0435 \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043E"
    - "\u0420\u0435\u0446\u0435\u043F\u0442 \u0437\u0456\u0431\u0440\u0430\u043D\u043E,
      \u043C\u043E\u0436\u043D\u0430 \u043D\u0430\u0442\u0438\u0441\u043A\u0430\u0442\u0438"
    correctOption: 2
    explanation: "\u0422\u0435\u043C\u043D\u043E-\u0447\u0435\u0440\u0432\u043E\u043D\u0430
      \u2013 \u0440\u0435\u0446\u0435\u043F\u0442 \u043D\u0435 \u0437\u0456\u0431\u0440\u0430\u043D\u043E,
      \u0437\u0435\u043B\u0435\u043D\u0430 \u2013 \u043C\u043E\u0436\u043D\u0430
      \u043A\u0440\u0430\u0444\u0442\u0438\u0442\u0438."
  - type: 1
    title: "\u041F\u043B\u0430\u043D\u0448\u0435\u0442"
    text: "\u042F\u043A \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438 \u043F\u043B\u0430\u043D\u0448\u0435\u0442?"
    options:
    - "\u041A\u043D\u043E\u043F\u043A\u0430 \u043C\u0435\u043D\u044E \u043B\u0456\u0432\u043E\u0433\u043E
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u0440\u0430"
    - "\u041A\u0443\u0440\u043E\u043A \u043F\u0440\u0430\u0432\u043E\u0433\u043E
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u0440\u0430"
    - "\u041A\u043D\u043E\u043F\u043A\u0430 A"
    correctOption: 0
    explanation: "\u041A\u043D\u043E\u043F\u043A\u0430 \u043C\u0435\u043D\u044E \u0454
      \u043B\u0438\u0448\u0435 \u043D\u0430 \u043B\u0456\u0432\u043E\u043C\u0443
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u0440\u0456."
  - type: 1
    title: "\u0422\u0435\u043B\u0435\u043F\u043E\u0440\u0442"
    text: "\u041A\u0443\u0434\u0438 \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442
      \u043D\u0435 \u043F\u0440\u0430\u0446\u044E\u0454?"
    options:
    - "\u041D\u0430 \u043F\u0456\u0434\u043B\u043E\u0433\u0443 \u0446\u0435\u0445\u0443"
    - "\u0412\u043F\u0440\u0438\u0442\u0443\u043B \u0434\u043E \u0441\u0442\u0456\u043D
      \u0456 \u0432 \u043C\u0435\u0431\u043B\u0456"
    - "\u0414\u043E \u0442\u043E\u0447\u043E\u043A \u0431\u0456\u043B\u044F \u0441\u0442\u043E\u043B\u0456\u0432"
    correctOption: 1
    explanation: "\u0411\u0456\u043B\u044F \u0441\u0442\u0456\u043D \u0456 \u043C\u0435\u0431\u043B\u0456\u0432
      \u2013 \u0437\u043E\u043D\u0438 \u0431\u0435\u0437 \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0443."

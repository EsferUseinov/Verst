  m_Script: {fileID: 11500000, guid: 3d8e49d323c576548a7691f17f969f4e, type: 3}
  m_Name: Wizard_FirstShift
  m_EditorClassIdentifier: Assembly-CSharp::WizardDefinition
  id: first_shift
  displayName: "\u041F\u0435\u0440\u0448\u0430 \u0437\u043C\u0456\u043D\u0430"
  intro: "\u0417\u0431\u0435\u0440\u0438 \u0441\u0432\u0456\u0439 \u043F\u0435\u0440\u0448\u0438\u0439
    \u043C\u0430\u043D\u043E\u043C\u0435\u0442\u0440 \u0456 \u0437\u0434\u0430\u0439
    \u0439\u043E\u0433\u043E \u043D\u0430 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C
    \u044F\u043A\u043E\u0441\u0442\u0456. \u041A\u0443\u0434\u0438 \u0439\u0442\u0438
    \u2013 \u043F\u0456\u0434\u043A\u0430\u0436\u0435 \u043C\u0430\u0440\u043A\u0435\u0440
    \u0443 \u0446\u0435\u0445\u0443. \u0420\u0430\u0445\u0443\u044E\u0442\u044C\u0441\u044F
    \u0447\u0430\u0441 \u0456 \u043F\u043E\u043C\u0438\u043B\u043A\u0438."
  passScore: 0.75
  steps:
  - type: 2
    title: "\u0414\u043E \u0441\u043A\u043B\u0430\u0434\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0441\u0442\u043E\u043B\u0443"
    text: "\u0414\u0456\u0441\u0442\u0430\u043D\u044C\u0441\u044F \u0441\u043A\u043B\u0430\u0434\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0441\u0442\u043E\u043B\u0443 \u0432 \u0446\u0435\u043D\u0442\u0440\u0456
      \u0446\u0435\u0445\u0443 \u2013 \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u043E\u043C
      (\u0441\u0442\u0456\u043A \u0443\u043F\u0435\u0440\u0435\u0434, \u043D\u0430\u0432\u0435\u0434\u0438
      \u0434\u0443\u0433\u0443 \u0439 \u0432\u0456\u0434\u043F\u0443\u0441\u0442\u0438)
      \u0430\u0431\u043E \u043F\u0456\u0448\u043A\u0438."
    options: []
    correctOption: 0
    explanation: 
    expectedEvent: at:assembly
    failEvent: 
    failHint: 
    markerId: assembly
  - type: 2
    title: "\u0428\u0435\u0441\u0442\u0435\u0440\u043D\u044F \u2013 \u0432 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0438\u0439
      \u0441\u043B\u043E\u0442"
    text: "\u0412\u0456\u0437\u044C\u043C\u0438 \u0448\u0435\u0441\u0442\u0435\u0440\u043D\u044E
      \u0437\u0456 \u0441\u0442\u043E\u043B\u0443 \u0439 \u043F\u043E\u043A\u043B\u0430\u0434\u0438
      \u0457\u0457 \u0432 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0438\u0439
      \u0441\u043B\u043E\u0442 \u0441\u0442\u0430\u043D\u0446\u0456\u0457. \u0421\u043B\u043E\u0442
      \u0437\u0430\u0441\u0432\u0456\u0442\u0438\u0442\u044C\u0441\u044F \u0437\u0435\u043B\u0435\u043D\u0438\u043C."
    options: []
    correctOption: 0
    explanation: 
    expectedEvent: placed:base:gear
    failEvent: 
    failHint: 
    markerId: slot_base
  - type: 1
    title: "\u041A\u0443\u0434\u0438 \u0431\u043E\u043B\u0442?"
    text: "\u0428\u0435\u0441\u0442\u0435\u0440\u043D\u044F \u043D\u0430 \u043C\u0456\u0441\u0446\u0456.
      \u041A\u0443\u0434\u0438 \u0442\u0435\u043F\u0435\u0440 \u043F\u043E\u043A\u043B\u0430\u0441\u0442\u0438
      \u0431\u043E\u043B\u0442?"
    options:
    - "\u0423 \u0431\u0456\u0447\u043D\u0438\u0439 \u0441\u043B\u043E\u0442"
    - "\u0422\u0435\u0436 \u0443 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0438\u0439"
    - "\u041D\u0430 \u043F\u0430\u043B\u0435\u0442\u0443"
    correctOption: 0
    explanation: "\u0426\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0438\u0439
      \u0441\u043B\u043E\u0442 \u2013 \u0434\u043B\u044F \u0434\u0435\u0442\u0430\u043B\u0435\u0439,
      \u0431\u0456\u0447\u043D\u0456 \u2013 \u0434\u043B\u044F \u043A\u0440\u0456\u043F\u043B\u0435\u043D\u044C."
    expectedEvent: 
    failEvent: 
    failHint: 
    markerId: 
  - type: 2
    title: "\u0411\u043E\u043B\u0442 \u2013 \u0443 \u0431\u0456\u0447\u043D\u0438\u0439
      \u0441\u043B\u043E\u0442"
    text: "\u0412\u0456\u0437\u044C\u043C\u0438 \u0431\u043E\u043B\u0442 \u0456 \u043F\u043E\u043A\u043B\u0430\u0434\u0438
      \u0439\u043E\u0433\u043E \u0432 \u0431\u0456\u0447\u043D\u0438\u0439 \u0441\u043B\u043E\u0442
      \u0441\u0442\u0430\u043D\u0446\u0456\u0457."
    options: []
    correctOption: 0
    explanation: 
    expectedEvent: placed:fastener:bolt_m10
    failEvent: 
    failHint: 
    markerId: slot_fastener
  - type: 1
    title: "\u041A\u043D\u043E\u043F\u043A\u0430 \u043A\u0440\u0430\u0444\u0442\u0443"
    text: "\u041A\u043D\u043E\u043F\u043A\u0430 \u043F\u0440\u0430\u0432\u043E\u0440\u0443\u0447
      \u0432\u0456\u0434 \u0441\u0442\u0430\u043D\u0446\u0456\u0457 \u0441\u0442\u0430\u043B\u0430
      \u0437\u0435\u043B\u0435\u043D\u043E\u044E. \u0429\u043E \u0446\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u0454?"
    options:
    - "\u0421\u0442\u0430\u043D\u0446\u0456\u044F \u0437\u043B\u0430\u043C\u0430\u043B\u0430\u0441\u044C"
    - "\u041A\u0440\u0430\u0444\u0442 \u0443\u0436\u0435 \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043E"
    - "\u0420\u0435\u0446\u0435\u043F\u0442 \u0437\u0456\u0431\u0440\u0430\u043D\u043E
      \u2013 \u043C\u043E\u0436\u043D\u0430 \u043D\u0430\u0442\u0438\u0441\u043A\u0430\u0442\u0438"
    correctOption: 2
    explanation: "\u0422\u0435\u043C\u043D\u043E-\u0447\u0435\u0440\u0432\u043E\u043D\u0430
      \u2013 \u0440\u0435\u0446\u0435\u043F\u0442 \u043D\u0435 \u0437\u0456\u0431\u0440\u0430\u043D\u043E,
      \u0437\u0435\u043B\u0435\u043D\u0430 \u2013 \u043C\u043E\u0436\u043D\u0430
      \u043A\u0440\u0430\u0444\u0442\u0438\u0442\u0438."
    expectedEvent: 
    failEvent: 
    failHint: 
    markerId: 
  - type: 2
    title: "\u0421\u043A\u0440\u0430\u0444\u0442\u0438 \u043C\u0430\u043D\u043E\u043C\u0435\u0442\u0440"
    text: "\u041D\u0430\u0442\u0438\u0441\u043D\u0438 \u0437\u0435\u043B\u0435\u043D\u0443
      \u043A\u043D\u043E\u043F\u043A\u0443 \u2013 \u043F\u0440\u043E\u043C\u0456\u043D\u0435\u043C
      \u0456 \u043A\u0443\u0440\u043A\u043E\u043C \u0430\u0431\u043E \u0442\u043E\u0440\u043A\u043D\u0443\u0432\u0448\u0438\u0441\u044C
      \u0457\u0457 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u0440\u043E\u043C."
    options: []
    correctOption: 0
    explanation: 
    expectedEvent: crafted:gauge
    failEvent: craft_failed
    failHint: "\u041A\u043D\u043E\u043F\u043A\u0430 \u0449\u0435 \u043D\u0435 \u0431\u0443\u043B\u0430
      \u0437\u0435\u043B\u0435\u043D\u043E\u044E \u2013 \u0443 \u0441\u043B\u043E\u0442\u0430\u0445
      \u0431\u0440\u0430\u043A\u0443\u0454 \u0434\u0435\u0442\u0430\u043B\u0435\u0439.
      \u041F\u0435\u0440\u0435\u0432\u0456\u0440 \u0448\u0435\u0441\u0442\u0435\u0440\u043D\u044E
      \u0439 \u0431\u043E\u043B\u0442."
    markerId: craft_button
  - type: 2
    title: "\u041E\u0433\u043B\u044F\u0434\u0438 \u043C\u0430\u043D\u043E\u043C\u0435\u0442\u0440"
    text: "\u041D\u0430\u0432\u0435\u0434\u0438 \u043F\u0440\u043E\u043C\u0456\u043D\u044C
      \u043D\u0430 \u043D\u043E\u0432\u0438\u0439 \u043C\u0430\u043D\u043E\u043C\u0435\u0442\u0440
      \u0430\u0431\u043E \u0432\u0456\u0437\u044C\u043C\u0438 \u0439\u043E\u0433\u043E
      \u0432 \u0440\u0443\u043A\u0443."
    options: []
    correctOption: 0

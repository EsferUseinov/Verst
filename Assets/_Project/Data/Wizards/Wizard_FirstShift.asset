    markerId: slot_base
  - type: 2
    title: "\u0417\u0434\u0430\u0439 \u043D\u0430 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C"
    text: "\u0412\u0456\u0434\u043D\u0435\u0441\u0438 \u043C\u0430\u043D\u043E\u043C\u0435\u0442\u0440
      \u043D\u0430 \u0441\u0442\u0456\u043B \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044E
      \u044F\u043A\u043E\u0441\u0442\u0456 \u043F\u0440\u0430\u0432\u043E\u0440\u0443\u0447
      \u0456 \u043F\u043E\u043A\u043B\u0430\u0434\u0438 \u0439\u043E\u0433\u043E
      \u0432 \u0437\u043E\u043D\u0443 \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u043A\u0438."
